<gatein-resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_resources_1_5 http://www.exoplatform.org/xml/ns/gatein_resources_1_5" xmlns="http://www.exoplatform.org/xml/ns/gatein_resources_1_5">
  <module>
    <name>AttachmentPreviewPDF</name>
    <load-group>baseGRP</load-group>
    <script>
      <path>/js/documentsPreviewPDF.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>pdfjsWorkerConfig</module>
    </depends>
    <depends>
      <module>AttachmentPreview</module>
    </depends>
  </module>

  <module>
    <name>pdfjs</name>
    <script>
      <minify>false</minify>
      <path>/js/pdf.min.js</path>
    </script>
  </module>

  <module>
    <name>pdfjsWorkerConfig</name>
    <script>
      <adapter>
        (function() {
          window.pdfjsLib = window.pdfjsDistBuildPdf;
          window.pdfjsLib.PDFJS.workerSrc = '/documents-preview/js/pdf.worker.min.js';
          return window.pdfjsLib;
        })();
      </adapter>
    </script>
    <depends>
      <module>pdfjs</module>
    </depends>
  </module>
</gatein-resources>
